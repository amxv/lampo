---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Live feedback",
    body: "Planned: edit a .tex file and see changes reflected in the browser without manually refreshing or rebuilding."
  },
  {
    title: "One terminal command",
    body: "Planned: start a local preview server in your project directory and open the URL in any browser."
  },
  {
    title: "Export when ready",
    body: "Planned: save the rendered result directly as a PDF, without interrupting the preview session."
  },
  {
    title: "Agent-friendly by design",
    body: "A lightweight local tool that stays out of the way while coding agents edit LaTeX source files."
  }
];

const workflows = [
  "Watch LaTeX source and included files for changes.",
  "Compile with minimal latency and stream state to a browser preview.",
  "Keep the preview responsive through errors and rebuilds.",
  "Export a named PDF directly from the browser."
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Introducing Lampo · In development</p>
      <h1>LaTeX at the speed of thought.</h1>
      <p class="hero__lede">
        A tiny command-line tool for an instant, always-open LaTeX preview in your browser.
        Edit the source, watch it update, and export the finished PDF when you're done.
      </p>
      <p class="hero__annotation">
        Built with coding agents in mind. The repository is live; the preview engine is next.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="https://github.com/amxv/lampo">View on GitHub</a>
        <a class="button button--ghost" href="/docs">Developer docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">What's being built</p>
      <ul class="hero__signal-list">
        <li>Local LaTeX watch and compile loop.</li>
        <li>Low-latency browser preview.</li>
        <li>One-click PDF download.</li>
      </ul>
      <div class="hero__terminal">
        <span># Repository scaffold is available now</span>
        <span>$ git clone https://github.com/amxv/lampo</span>
        <span>$ cd lampo</span>
        <span>$ make check</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">The idea</p>
      <h2>The edit–compile–refresh loop should disappear.</h2>
      <p>
        Live previews are ordinary in web development. Lampo aims to bring that same
        effortless feedback loop to LaTeX, without a heavyweight editor or a special workflow.
        These capabilities are planned, not yet released.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell split-section">
    <div>
      <p class="section-label">Roadmap</p>
      <h2>Small footprint. Fast feedback. A browser is all you need.</h2>
    </div>
    <div class="stack-list">
      {workflows.map((item) => (
        <article class="stack-list__item">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell capability-band">
    <div class="capability-band__intro">
      <p class="section-label">Foundation in place</p>
      <h2>The project infrastructure is ready for development.</h2>
    </div>
    <div class="capability-band__grid">
      <div>
        <p class="capability-title">Go CLI</p>
        <p>Starter command, build, tests, version plumbing, and development targets.</p>
      </div>
      <div>
        <p class="capability-title">npm distribution</p>
        <p>JavaScript shim and native binary installer, ready for the first real release.</p>
      </div>
      <div>
        <p class="capability-title">Release pipeline</p>
        <p>GitHub Actions for binaries, GitHub Releases, and npm publication from version tags.</p>
      </div>
      <div>
        <p class="capability-title">Docs site</p>
        <p>Astro and ZueDocs, with project notes hosted at lampo.ashray.xyz.</p>
      </div>
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Follow development from the first commit.</h2>
      <p>
        For now the docs describe the starter command, local development, and release setup.
        User-facing preview commands will be documented as they are implemented.
      </p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell closing-note">
    <p>
      Lampo is in early development. Follow along on GitHub.
    </p>
  </section>
</BaseLayout>
