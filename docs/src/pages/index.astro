---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Live feedback",
    body: "Save a .tex file and the preview quietly refreshes itself. No manual builds, no page reload."
  },
  {
    title: "One terminal command",
    body: "Run lampo in your project directory to start a tiny localhost server and open your browser."
  },
  {
    title: "Export when ready",
    body: "Choose a filename and download a crisp PDF straight from the preview toolbar."
  },
  {
    title: "Agent-friendly by design",
    body: "Work across multiple standalone documents and included files, switching previews from one small searchable menu."
  }
];

const workflows = [
  "Watch LaTeX source, included chapters, bibliographies and figures across the entire project.",
  "Debounce saves, compile with latexmk, and stream updates over local HTTP.",
  "Keep the last good PDF in view, even when an edit breaks the build.",
  "Switch among cached documents, zoom, follow links and export a named PDF."
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Introducing Lampo · Source preview available</p>
      <h1>LaTeX at the speed of thought.</h1>
      <p class="hero__lede">
        A tiny command-line tool for an instant, always-open LaTeX preview in your browser.
        Edit the source, watch it update, and export the finished PDF when you're done.
      </p>
      <p class="hero__annotation">
        Built with coding agents in mind. The preview works today from source, with the first public binary release coming after testing.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="https://github.com/amxv/lampo">View on GitHub</a>
        <a class="button button--ghost" href="/docs">Developer docs</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Ready for local testing</p>
      <ul class="hero__signal-list">
        <li>Native file watching and LaTeX builds.</li>
        <li>Bundled PDF.js preview, no CDN.</li>
        <li>Named PDF downloads in the browser.</li>
      </ul>
      <div class="hero__terminal">
        <span># Build and install from source</span>
        <span>$ git clone https://github.com/amxv/lampo</span>
        <span>$ cd lampo</span>
        <span>$ make install-local</span>
        <span>$ lampo ~/projects/paper/main.tex</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">The idea</p>
      <h2>The edit–compile–refresh loop should disappear.</h2>
      <p>
        Live previews are ordinary in web development. Lampo brings that same
        effortless feedback loop to LaTeX, without a heavyweight editor or special workflow.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell split-section">
    <div>
      <p class="section-label">Workflow</p>
      <h2>Small footprint. Fast feedback. A browser is all you need.</h2>
    </div>
    <div class="stack-list">
      {workflows.map((item) => (
        <article class="stack-list__item">
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell capability-band">
    <div class="capability-band__intro">
      <p class="section-label">Foundation in place</p>
      <h2>Minimal dependencies, built for real work.</h2>
    </div>
    <div class="capability-band__grid">
      <div>
        <p class="capability-title">Go CLI</p>
        <p>One native binary includes the HTTP server, filesystem watcher and browser UI.</p>
      </div>
      <div>
        <p class="capability-title">npm distribution</p>
        <p>Tag-driven native releases and an npm shim are ready for first publication.</p>
      </div>
      <div>
        <p class="capability-title">Release pipeline</p>
        <p>GitHub Actions for binaries, GitHub Releases, and npm publication from version tags.</p>
      </div>
      <div>
        <p class="capability-title">Docs site</p>
        <p>Astro and ZueDocs, with project notes hosted at lampo.ashray.xyz.</p>
      </div>
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Everything you need to get started.</h2>
      <p>
        Learn how to run your own live preview, tune the compiler, and build Lampo from source.
      </p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell closing-note">
    <p>
      Lampo is being tested before its first release. Try the source build and follow along on GitHub.
    </p>
  </section>
</BaseLayout>
